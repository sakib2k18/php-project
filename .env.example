APP_NAME="KUET TRY"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
# When served with `php artisan serve`
APP_URL=http://localhost:8000
# When served through XAMPP/Apache use: APP_URL=http://localhost/kuet-try/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=4306
DB_DATABASE=kuet_try
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@kuettry.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------
# KUET TRY organisation defaults (overridable from the admin panel)
# ---------------------------------------------------------------
SITE_ORG_NAME="KUET TRY"
SITE_ORG_SHORT_NAME="KUET TRY"
SITE_CURRENCY_CODE=BDT
SITE_CURRENCY_SYMBOL="Tk"
SITE_LATITUDE=22.899310
SITE_LONGITUDE=89.502289

# ---------------------------------------------------------------
# External APIs (all keyless / free tiers)
# ---------------------------------------------------------------
WEATHER_ENABLED=true
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEZONE=Asia/Dhaka
WEATHER_CACHE_MINUTES=30
WEATHER_TIMEOUT=6

MAP_ENABLED=true
MAP_PROVIDER=openstreetmap
MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
MAP_DEFAULT_ZOOM=14
MAP_MAX_ZOOM=19

GEOCODER_ENABLED=false
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT="KUET-TRY-University-Project/1.0 (contact: info@kuettry.org)"
GEOCODER_CACHE_DAYS=30

VITE_APP_NAME="${APP_NAME}"
